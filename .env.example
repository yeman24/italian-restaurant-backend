# Server
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://aura:aura_secret@localhost:5432/aura_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=aura_super_secret_access_jwt_key_2025_edinburgh_fine_dining
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=aura_super_secret_refresh_jwt_key_2025_edinburgh_cellar_vaults
JWT_REFRESH_EXPIRATION=7d

# Stripe Payments (Optional in Dev - Mock Mode Available)
STRIPE_SECRET_KEY=sk_test_mock_secret_key
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret

# Resend Transactional Email (Optional in Dev - Mock Mode Available)
RESEND_API_KEY=re_mock_api_key
RESEND_FROM_EMAIL=concierge@aura-edinburgh.com

# Cloudinary Storage (Optional in Dev - Mock Mode Available)
CLOUDINARY_CLOUD_NAME=aura-edinburgh
CLOUDINARY_API_KEY=mock_cloudinary_key
CLOUDINARY_API_SECRET=mock_cloudinary_secret

# Gemini Dining Concierge (Optional - local menu-aware fallback works without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
