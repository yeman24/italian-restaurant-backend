# Server
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173
RESTAURANT_TIMEZONE=Europe/London
RESERVATION_HORIZON_DAYS=90
RESERVATION_POLICY_VERSION=2026-01
DEPOSIT_REQUIRED=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://aura:aura_secret@localhost:5432/aura_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (generate unique values outside source control)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Stripe Payments (required when DEPOSIT_REQUIRED=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Development seed credentials (never commit actual values)
SEED_ADMIN_PASSWORD=
SEED_SOMMELIER_PASSWORD=

# Resend Transactional Email (required in production)
RESEND_API_KEY=
RESEND_FROM_EMAIL=concierge@aura-edinburgh.com
RESEND_ALERT_EMAIL=

# Cloudinary Storage (required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini Dining Concierge (Optional - local menu-aware fallback works without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
